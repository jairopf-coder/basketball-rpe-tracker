{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'staff'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'staff'",
        "displayName": { ".write": "auth != null && auth.uid === $uid" },
        "email":       { ".write": "auth != null && auth.uid === $uid" },
        "photoURL":    { ".write": "auth != null && auth.uid === $uid" },
        "role": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'staff'"
        },
        "playerLink": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'staff'"
        }
      }
    },
    "players": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "sessions": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".indexOn": ["date"]
    },
    "wellness": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "wellnessPlayer": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() !== 'player')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() !== 'player')"
      }
    },
    "playerRpeReports": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() !== 'player')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() !== 'player')"
      }
    },
    "pushSubscriptions": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['endpoint', 'keys', 'updatedAt'])",
        "endpoint": { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/) && newData.val().length < 1000" },
        "keys": {
          ".validate": "newData.hasChildren(['p256dh', 'auth'])",
          "p256dh": { ".validate": "newData.isString() && newData.val().length < 200" },
          "auth":   { ".validate": "newData.isString() && newData.val().length < 100" },
          "$other": { ".validate": false }
        },
        "updatedAt": { ".validate": "newData.isString() && newData.val().length < 40" },
        "$other": { ".validate": false }
      }
    },
    "pushStatus": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['active', 'updatedAt'])",
        "active":    { ".validate": "newData.isBoolean()" },
        "updatedAt": { ".validate": "newData.isString() && newData.val().length < 40" },
        "$other": { ".validate": false }
      }
    },
    "injuries": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "availability": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "gpsData": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "gpsPlayerMap": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "exerciseLibrary": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "gymTemplates": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "templates": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "strength": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "gymSessions": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "testSessions": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "weekPlan": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "clinicalNotes": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "seasonBlocks": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    },
    "anamnesis": {
      "$pid": {
        ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
      }
    },
    "$other": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'player'"
    }
  }
}
