{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'staff'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'staff'",
        "displayName": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isString() && newData.val().length <= 120" },
        "email":       { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isString() && newData.val().length <= 254" },
        "photoURL":    { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isString() && newData.val().length < 200000" },
        "role": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'staff'",
          ".validate": "newData.val() === 'staff' || newData.val() === 'fisio' || newData.val() === 'player'"
        },
        "playerLink": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'staff'"
        },
        "playerId": { ".validate": "newData.isString() && newData.val().length <= 128" }
      }
    },
    "players": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "sessions": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".indexOn": ["date"]
    },
    "wellness": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "wellnessPlayer": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio'))",
        ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio'))",
        ".validate": "newData.hasChildren()",
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['date'])",
          "uid":      { ".validate": "newData.val() === $uid" },
          "date":     { ".validate": "newData.val() === $date" },
          "sleep":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
          "fatigue":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
          "mood":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
          "pain":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
          "rpe":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
          "period":   { ".validate": "newData.isBoolean()" },
          "ts":       { ".validate": "newData.isString() && newData.val().length < 40" },
          "playerId": { ".validate": "newData.isString() && newData.val().length <= 128 && (newData.val() === root.child('users').child($uid).child('playerId').val() || (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio'))" }
        }
      }
    },
    "playerRpeReports": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio'))",
        ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio'))",
        ".validate": "newData.hasChildren()",
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren()",
          "$type": {
            ".validate": "($type === 'morning' || $type === 'afternoon' || $type === 'match') && newData.hasChildren(['rpe'])",
            "uid":         { ".validate": "newData.val() === $uid" },
            "date":        { ".validate": "newData.val() === $date" },
            "sessionType": { ".validate": "newData.val() === $type" },
            "rpe":         { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
            "ts":          { ".validate": "newData.isString() && newData.val().length < 40" },
            "reviewed":    { ".validate": "newData.isBoolean()" },
            "reviewedAt":  { ".validate": "newData.isString() && newData.val().length < 40" },
            "playerId":    { ".validate": "newData.isString() && newData.val().length <= 128 && (newData.val() === root.child('users').child($uid).child('playerId').val() || (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio'))" }
          }
        }
      }
    },
    "pushSubscriptions": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['endpoint', 'keys', 'updatedAt'])",
        "endpoint": { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/) && newData.val().length < 1000" },
        "keys": {
          ".validate": "newData.hasChildren(['p256dh', 'auth'])",
          "p256dh": { ".validate": "newData.isString() && newData.val().length < 200" },
          "auth":   { ".validate": "newData.isString() && newData.val().length < 100" },
          "$other": { ".validate": false }
        },
        "updatedAt": { ".validate": "newData.isString() && newData.val().length < 40" },
        "$other": { ".validate": false }
      }
    },
    "pushStatus": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['active', 'updatedAt'])",
        "active":    { ".validate": "newData.isBoolean()" },
        "updatedAt": { ".validate": "newData.isString() && newData.val().length < 40" },
        "$other": { ".validate": false }
      }
    },
    "injuries": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "availability": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "gpsData": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "gpsPlayerMap": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "exerciseLibrary": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "gymTemplates": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "templates": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "strength": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "gymSessions": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "testSessions": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "weekPlan": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "clinicalNotes": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "seasonBlocks": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "anamnesis": {
      "$pid": {
        ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
      }
    },
    "matches": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    },
    "$other": {
      ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'fisio')"
    }
  }
}
